# Local defaults. Copy to .env. Do not commit .env or deploy.env.

AUTH_SECRET=change-me-to-a-long-random-string
DATA_DIR=./data
ADMIN_EMAIL=glenn.will799@gmail.com
# Optional. If empty, the first boot writes a random password to $DATA_DIR/owner-password.txt
ADMIN_INITIAL_PASSWORD=

# file = local fixtures/dev-catalog.json copy (dev only)
# http = sunshine-inventory-test session + POST /api/import
# gcs = shared catalog.json in the inventory test bucket
# Cloud Run deploy sets INVENTORY_TRANSPORT=gcs and object catalog.json.
# auto = http when inventory creds exist, else file outside production
INVENTORY_TRANSPORT=file
INVENTORY_BASE_URL=https://sunshine-inventory-test-k6uuoen7wa-ue.a.run.app
INVENTORY_EMAIL=
INVENTORY_PASSWORD=
INVENTORY_GCS_BUCKET=
INVENTORY_GCS_OBJECT=data/catalog.json

# Live clock is read-only. Use the test host if you do not want the live floor feed.
TIMECLOCK_BASE_URL=https://sunshine-timeclock-k6uuoen7wa-ue.a.run.app
# TIMECLOCK_BASE_URL=https://sunshine-timeclock-test-k6uuoen7wa-ue.a.run.app
TIMECLOCK_IDENTIFIER=
TIMECLOCK_PASSWORD=
TIMECLOCK_DEFAULT_STORE=Irondale

SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_ID=
# Optional {"Alex":"U012345"} mentions on overdue Slack
SLACK_ASSIGNEE_MAP=

# Bakery Square token for the account that owns Irondale. Stock only.
SQUARE_ACCESS_TOKEN=
SQUARE_API_BASE=https://connect.squareup.com
# Sandbox host, if the token is a sandbox token:
# SQUARE_API_BASE=https://connect.squareupsandbox.com

PUBLIC_BASE_URL=http://localhost:3000
CRON_SECRET=
OVERDUE_BUFFER_MINUTES=10
REALERT_MINUTES=15
